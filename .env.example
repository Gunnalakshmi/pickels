# ==========================================
# PickleMart India - Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# For local fallback, if DATABASE_URL is not supplied, an embedded database adapter is automatically used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picklemart

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_picklemart_2026_india
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (TEST / PRODUCTION)
PAYMENT_MODE=TEST
PAYMENT_API_KEY=rzp_test_picklemart_dummy_key_12345
PAYMENT_SECRET=rzp_secret_dummy_pickle_secret_67890
PAYMENT_WEBHOOK_SECRET=whsec_dummy_webhook_secret_99999

# Cloud Storage / Media (S3 / Cloudflare R2 / Local)
STORAGE_DRIVER=local
STORAGE_BUCKET=picklemart-assets
STORAGE_KEY=dummy_storage_access_key
STORAGE_SECRET=dummy_storage_secret_key

# SMS & Communication (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER=mock
SMS_API_KEY=dummy_sms_api_key_msg91

# Email Service (SendGrid / Resend / Nodemailer)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=dummy_resend_api_key
EMAIL_FROM="PickleMart India <support@picklemart.in>"

# Shipping / Logistics (Shiprocket / Delhivery)
LOGISTICS_PROVIDER=mock
SHIPROCKET_EMAIL=shipping@picklemart.in
SHIPROCKET_PASSWORD=dummy_shiprocket_password

# Store & Legal Compliance Info
STORE_NAME="PickleMart India"
STORE_EMAIL="support@picklemart.in"
STORE_PHONE="+91 98765 43210"
STORE_FSSAI_NUMBER="10021042000889"
STORE_GSTIN="36AAACP1234M1Z5"
DEFAULT_GST_RATE=5
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_FEE=50
